#!/usr/bin/env bash
# Restore the most recently minimized window to its origin workspace.
# Reverses appdock-minimize: moves the window back, focuses it, and removes
# its sidecar entry (state, history line, thumbnail).
#
# Security posture: reads state ONLY from $XDG_RUNTIME_DIR (owner-only dir,
# never /tmp). All data crossing into python is passed as argv.
set -euo pipefail

sidecar_dir="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set; refusing to fall back to shared temp (requires a systemd/wayland session)}/hyprland-minimizer"

python3 - "$sidecar_dir" <<'PYEOF'
import json, os, subprocess, sys

sidecar_dir = sys.argv[1]
state_file = os.path.join(sidecar_dir, "state.json")
history_file = os.path.join(sidecar_dir, "history.txt")

def hyprctl_json(*args):
    try:
        out = subprocess.run(
            ["hyprctl", *args, "-j"], capture_output=True, text=True, timeout=10
        )
        return json.loads(out.stdout or "null")
    except (subprocess.SubprocessError, ValueError):
        return None

def fail(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)

if not os.path.exists(history_file):
    fail("No minimized windows to restore")

with open(history_file) as f:
    lines = [l.strip() for l in f if l.strip()]
if not lines:
    fail("No minimized windows to restore")
address = lines[0]

state = {}
if os.path.exists(state_file):
    try:
        with open(state_file) as f:
            state = json.load(f)
        if not isinstance(state, dict):
            state = {}
    except (ValueError, OSError):
        state = {}

entry = state.get(address) or {}
target_ws = str(entry.get("workspace") or "")
if target_ws == "" or target_ws == "special:minimized":
    active = hyprctl_json("activeworkspace") or {}
    target_ws = str(active.get("name") or "1")

subprocess.run(
    ["hyprctl", "dispatch",
     f'hl.dsp.window.move({{ window = "address:{address}", '
     f'workspace = "{target_ws}", follow = true }})'],
    capture_output=True,
)
subprocess.run(
    ["hyprctl", "dispatch",
     f'hl.dsp.focus({{ window = "address:{address}" }})'],
    capture_output=True,
)

# Clean the sidecar: capture the thumb path BEFORE popping the entry, or it
# is unreachable and the thumbnail leaks.
thumb = str(entry.get("thumb") or "")
state.pop(address, None)
if state:
    fd = os.open(state_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(state, f)
else:
    try:
        os.remove(state_file)
    except OSError:
        pass

lines = [l for l in lines if l != address]
if lines:
    fd = os.open(history_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write("".join(l + "\n" for l in lines))
else:
    try:
        os.remove(history_file)
    except OSError:
        pass

if thumb and os.path.exists(thumb):
    try:
        os.remove(thumb)
    except OSError:
        pass

print(f"Restored: {address} -> workspace {target_ws}")
PYEOF
