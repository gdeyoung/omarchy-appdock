#!/usr/bin/env bash
# Minimize a window to special:minimized (Hyprland 0.56 has no native minimize).
# Records the origin workspace in the shared minimizer sidecar so docks can
# restore windows to where they came from.
#
# Security posture: runtime state lives ONLY under $XDG_RUNTIME_DIR in an
# owner-only directory (never /tmp). All data crossing into python is passed
# as argv — never interpolated into source. Window addresses are validated.
set -euo pipefail

sidecar_dir="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set; refusing to fall back to shared temp (requires a systemd/wayland session)}/hyprland-minimizer"
mkdir -p "$sidecar_dir"
chmod 700 "$sidecar_dir"

# Resolve the target: $1 if given (validated), else the focused window.
if [[ $# -ge 1 && -n "$1" ]]; then
    address="$1"
    if [[ ! "$address" =~ ^0x[0-9a-fA-F]+$ ]]; then
        echo "Invalid window address: $address" >&2
        exit 2
    fi
else
    address="$(hyprctl activewindow -j 2>/dev/null | python3 -c 'import sys,json; print(json.load(sys.stdin).get("address",""))' 2>/dev/null || true)"
fi

if [[ -z "$address" || "$address" == "null" || "$address" == "None" ]]; then
    echo "No focused window to minimize" >&2
    exit 1
fi

# Everything else — client lookup, the move, the thumbnail, and the sidecar
# write — happens in one python pass. Client info is read BEFORE the move so
# the origin workspace is the real one, not special:minimized.
python3 - "$sidecar_dir" "$address" <<'PYEOF'
import json, os, subprocess, sys

sidecar_dir, address = sys.argv[1], sys.argv[2]

def hyprctl_json(*args):
    try:
        out = subprocess.run(
            ["hyprctl", *args, "-j"], capture_output=True, text=True, timeout=10
        )
        return json.loads(out.stdout or "[]")
    except (subprocess.SubprocessError, ValueError):
        return None

clients = hyprctl_json("clients") or []
client = next((c for c in clients if c.get("address") == address), {})
title = str(client.get("title") or "untitled")
ws = str((client.get("workspace") or {}).get("name") or "")
mon = str((client.get("monitor") or {}).get("name") or "")

moved = subprocess.run(
    ["hyprctl", "dispatch",
     f'hl.dsp.window.move({{ window = "address:{address}", '
     f'workspace = "special:minimized", follow = false }})'],
    capture_output=True, text=True,
)
if moved.returncode != 0:
    print("Failed to minimize window", file=sys.stderr)
    sys.exit(1)

# Thumbnail (optional — headless/failed captures are tolerated, not fatal).
thumb = os.path.join(sidecar_dir, "thumb_" + address.replace("x", "") + ".png")
subprocess.run(["grim", "-w", address, thumb], capture_output=True)
try:
    os.chmod(thumb, 0o600)
except OSError:
    pass

# Sidecar: state.json (origin per address) + history.txt (MRU order).
state_file = os.path.join(sidecar_dir, "state.json")
history_file = os.path.join(sidecar_dir, "history.txt")

existing = {}
if os.path.exists(state_file):
    try:
        with open(state_file) as f:
            existing = json.load(f)
        if not isinstance(existing, dict):
            existing = {}
    except (ValueError, OSError):
        existing = {}

existing[address] = {"workspace": ws, "monitor": mon, "thumb": thumb}
fd = os.open(state_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    json.dump(existing, f)
try:
    os.chmod(state_file, 0o600)  # tighten files created by older versions
except OSError:
    pass

lines = []
if os.path.exists(history_file):
    with open(history_file) as f:
        lines = [l.strip() for l in f if l.strip()]
lines = [l for l in lines if l != address]
lines.insert(0, address)
fd = os.open(history_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    f.write("".join(l + "\n" for l in lines))
try:
    os.chmod(history_file, 0o600)  # tighten files created by older versions
except OSError:
    pass

print(f"Minimized: {title} ({address})")
PYEOF
